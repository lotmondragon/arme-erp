# .env.example
# Este archivo es un template. Copia a .env y actualiza los valores

# ============================================
# BASE DE DATOS
# ============================================
POSTGRES_USER=arme
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
POSTGRES_DB=arme_erp

# ============================================
# JWT & AUTENTICACIÓN
# ============================================
JWT_SIGNING_CERT_PATH=/app/certs/signing-cert.pfx
JWT_SIGNING_CERT_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
CLIENT_SECRET=CHANGE_ME_TO_VERY_LONG_SECURE_SECRET

# ============================================
# URLS (Desarrollo)
# ============================================
AUTH_URL=http://auth:8080
API_URL=http://api:8080
FRONTEND_URL=http://localhost:8080

# ============================================
# ENTORNO
# ============================================
ASPNETCORE_ENVIRONMENT=Development

# ============================================
# URLS EXTERNAS (Para frontend desde navegador)
# ============================================
AUTH_URL_EXTERNAL=http://localhost:5080
API_URL_EXTERNAL=http://localhost:5070
